+package hu.babatamogatas.app;
+
+import java.time.LocalDate;
+import java.util.*;
+
+/**
+ * Deterministic import-window filter. It trims imported evidence to the selected
+ * CSED-start-based two-year window without asking the AI to decide relevance.
+ */
+public final class EligibilityImportProcessor {
+    private EligibilityImportProcessor() {}
+
+    public static List<EmploymentPeriod> filterToCsedImportWindow(List<EmploymentPeriod> input, LocalDate windowStart, LocalDate csedStart) {
+        List<EmploymentPeriod> out = new ArrayList<>();
+        if(input==null || windowStart==null || csedStart==null) return out;
+        for(EmploymentPeriod p: input){
+            if(p==null || p.start==null) continue;
+            LocalDate effectiveEnd = p.end==null ? csedStart : p.end;
+            if(effectiveEnd.isBefore(windowStart) || p.start.isAfter(csedStart)) continue;
+            LocalDate start = p.start.isBefore(windowStart) ? windowStart : p.start;
+            LocalDate end = p.end;
+            if(end!=null && end.isAfter(csedStart)) end=csedStart;
+            List<String> evidence = new ArrayList<>(p.documentEvidence);
+            if(p.start.isBefore(windowStart)) evidence.add("Importablakra szűrve • eredeti kezdet: "+p.start);
+            List<EmploymentPeriod.IncomeRecord> incomes = new ArrayList<>();
+            for(EmploymentPeriod.IncomeRecord r:p.incomeRecords){
+                if(r==null || r.start==null) continue;
+                LocalDate re=r.end==null?r.start:r.end;
+                if(re.isBefore(windowStart) || r.start.isAfter(csedStart)) continue;
+                LocalDate rs=r.start.isBefore(windowStart)?windowStart:r.start;
+                LocalDate rend=re.isAfter(csedStart)?csedStart:re;
+                incomes.add(new EmploymentPeriod.IncomeRecord(rs,rend,r.contributionIncome,r.incomeDays,r.official,r.source));
+            }
+            out.add(new EmploymentPeriod(p.relationshipId,p.employer,p.relationType,start,end,p.monthlyGross,p.insured,p.unpaidDays,p.sickPayDays,evidence,incomes));
+        }
+        return EmploymentImportNormalizer.normalize(out);
+    }
+}
